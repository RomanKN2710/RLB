# Verbindung zur Postgres-Datenbank (Neon/Supabase/Vercel Postgres). Beispiel:
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Geheimnis für Login-Cookies (langer Zufallstext, z. B. 40 Zeichen)
AUTH_SECRET=bitte-durch-langen-zufallstext-ersetzen
# Bundesliga-Saison für OpenLigaDB (2026 = Saison 2026/27)
SEASON=2026
# Erster Admin (wird von "npm run db:seed" angelegt, falls noch kein Benutzer existiert)
ADMIN_EMAIL=roman@example.com
ADMIN_PASSWORD=startpasswort
# Optional: Manager-Team des Admins (Name aus db/seed/runde1.json), damit der Admin auch mitspielt
ADMIN_MANAGER=Roman
# Optional: Schutz für den täglichen Sync-Aufruf (/api/sync?key=...)
CRON_SECRET=geheim
# kicker-Import: Basisadresse (kicker.de oder kicker.ch) und Saison-Kürzel
KICKER_BASE=https://www.kicker.de
KICKER_SEASON=2026-27
