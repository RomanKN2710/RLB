# Verbindung zur Postgres-Datenbank (Neon/Supabase/Vercel Postgres). Beispiel:
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Geheimnis für Login-Cookies (langer Zufallstext, z. B. 40 Zeichen)
AUTH_SECRET=bitte-durch-langen-zufallstext-ersetzen
# Bundesliga-Saison für OpenLigaDB (2026 = Saison 2026/27)
SEASON=2026
# Erster Admin (wird von "npm run db:seed" angelegt, falls noch kein Benutzer existiert)
ADMIN_EMAIL=roman@example.com
ADMIN_PASSWORD=startpasswort
# Optional: Manager-Team des Admins (Name aus db/seed/runde1.json), damit der Admin auch mitspielt
ADMIN_MANAGER=Roman
# Schlüssel für den täglichen Sync, die Einrichtung und den Status (/api/sync, /api/setup, /api/status). Pflicht.
CRON_SECRET=geheim
# Eigener Schlüssel nur für den kicker-Eingang (Handy-Skript). Empfohlen; ohne ihn benutzt das Skript CRON_SECRET.
INBOX_KEY=anderer-langer-zufallstext
# kicker-Import: Basisadresse (kicker.de oder kicker.ch) und Saison-Kürzel
KICKER_BASE=https://www.kicker.de
KICKER_SEASON=2026-27
# Spieltagsbericht (automatisch nach Abschluss einer Runde): Claude-API-Schlüssel
ANTHROPIC_API_KEY=sk-ant-...
# Öffentliche Adresse der App (für den Hintergrundaufruf beim Abschluss einer Runde)
APP_URL=https://rlb-nine.vercel.app
# E-Mails der App (optional): Erinnerung vor der Deadline, Hinweis nach der Auswertung, Passwort zurücksetzen, Meldungen an die Admins.
# Dienst: Resend (https://resend.com). Ohne diese beiden Werte verschickt die App nichts.
RESEND_API_KEY=re_...
MAIL_FROM=RLB Managerspiel <rlb@deine-domain.ch>
